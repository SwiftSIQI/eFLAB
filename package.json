{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:data:styles": "ruby script/generate_playing_styles_data.rb",
    "generate:data:boosters": "ruby script/generate_boosters_data.rb",
    "generate:data:attributes": "ruby script/generate_attributes_data.rb",
    "generate:data:skills": "ruby script/generate_skills_data.rb",
    "generate:data": "ruby script/generate_playing_styles_data.rb && ruby script/generate_boosters_data.rb && ruby script/generate_attributes_data.rb && ruby script/generate_skills_data.rb && ruby script/generate_skill_combo_data.rb",
    "predev": "npm run normalize:data && npm run generate:data",
    "dev": "vite dev",
    "prebuild": "npm run normalize:data && npm run generate:data",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "prelint": "npm run normalize:data && npm run generate:data",
    "lint": "oxlint",
    "format": "oxfmt",
    "normalize:data": "ruby script/normalize_skill_recommendations.rb",
    "pretest": "npm run normalize:data && npm run generate:data",
    "test": "ruby test/data_pipeline_test.rb"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-server-dom-webpack": "19.3.0",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
